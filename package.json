{
  "name": "raleigh-renter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source-grounded Raleigh rental property public-record reports.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ci": "npm run check && npm run test:e2e",
    "test:live:openai": "node test/live/openai-live-smoke.mjs",
    "lint": "eslint .",
    "check": "npm run lint && node --check src/server.mjs && node --check public/app.js && npm test",
    "check:sources": "node scripts/check-sources.mjs",
    "build:wayan": "node scripts/build-wayan.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "pg": "^8.16.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1"
  }
}
